generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL = pooled (port 6543, ?pgbouncer=true) for the app;
  // DIRECT_URL = direct (port 5432) for prisma db push / migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(USER)
  phone         String?
  segment       CustomerSegment?
  loyaltyTier   String?
  primaryNeed   CustomerNeed?
  referralCode  String?   @unique // personal share code, e.g. KEG-24-JFEARON
  pointsRedeemed Int      @default(0) // lifetime points spent at checkout — available balance is loyaltyPoints() minus this
  lastActiveAt  DateTime? // last time the user engaged (drives admin online status)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  leads         Lead[]
  orders        Order[]
  tickets       SupportTicket[]
  npsResponses  NpsResponse[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  addresses     Address[]
  registeredUnits ProductUnit[]
  energyCheckups  EnergyCheckup[]
}

// Server-side cart snapshots — powers abandoned-cart tracking and conversion
// rate. Keyed by an anonymous cart id (cookie) and linked to a user/email when
// known. Marked CONVERTED when an order is placed.
model Cart {
  id        String   @id // client-generated cart id (also stored in a cookie)
  userId    String?
  email     String?
  items     Json     // [{ name, price, qty }]
  itemCount Int      @default(0)
  total     Float    @default(0)
  status    String   @default("ACTIVE") // ACTIVE | CONVERTED
  // When a recovery email was sent for this abandonment — null means not yet
  // sent, so the cron can find candidates and never send a second one for the
  // same abandonment. Reset to null on every /api/cart/sync upsert (any visit
  // that re-syncs the cart, not only a genuine edit — cheap to accept: worst
  // case a customer who keeps passively returning without buying can become
  // eligible for another reminder once the inactivity window re-elapses,
  // which is normal behavior for this kind of email, not a bug).
  recoveryEmailSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
}

// Saved delivery/billing addresses in the customer dashboard. Prefilled at
// checkout; one may be flagged as the default.
model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?  // e.g. "Home", "Office"
  name      String
  phone     String?
  street    String
  parish    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Per-customer notification center: order/shipping updates, restocks, discounts,
// promotions, warranty reminders, events and announcements. Unread + archive
// state let customers triage them like an inbox.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String   // ORDER | SHIPPING | NEW_PRODUCT | RESTOCK | DISCOUNT | PROMOTION | WARRANTY | EVENT | ANNOUNCEMENT
  title     String
  body      String?  @db.Text
  href      String?
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived, read])
}

// A customer's saved / favourited products. productId is the catalog id
// (e.g. "pb10") since the storefront reads lib/catalog.ts, not Product.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String   @id @default(cuid())
  // Stable link to the matching lib/catalog.ts entry this row overlays, if
  // any — set once (see scripts/backfillCatalogIds.ts) and never derived
  // from `name`, so renaming a product in admin can never fork it into a
  // second, duplicate storefront listing the way name-based matching did.
  catalogId   String?  @unique
  name        String
  description String   @db.Text
  shortDescription String? @db.Text // storefront card / summary copy
  price       Float
  salePrice   Float?   // optional sale price shown struck-through against price
  cost        Float?   // unit cost, for COGS / margin in the P&L
  icon        String?
  images      String[] // ordered storefront gallery URLs; images[0] = thumbnail
  features    String[]
  specs       Json?    // [{ label, value }] technical specifications
  brand       String?
  weight      String?
  dimensions  String?
  warranty    String?
  tags        String[] // search / merchandising tags
  sku         String?  @unique
  barcode     String?
  category    ProductCategory?
  spec        String?
  stock       Int      @default(0)
  threshold   Int      @default(5) // reorder threshold
  badge       String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  orderItems    OrderItem[]
  stockAdjustments StockAdjustment[]
  units         ProductUnit[]

  // getShopProducts()/metrics filter archived products out on every shop
  // and dashboard load.
  @@index([archived])
}

// One row per physical unit of inventory, carrying its own serial number —
// generated whenever stock is added, claimed (SOLD) when an order is placed,
// and REGISTERED once the customer enters it under "My devices". Lets a
// customer's invoice reference the exact unit(s) they received, and lets the
// devices page look up a real purchase date per serial instead of guessing.
model ProductUnit {
  id                 String    @id @default(cuid())
  productId          String
  serial             String    @unique
  status             String    @default("IN_STOCK") // IN_STOCK | SOLD | REGISTERED
  orderItemId        String?
  registeredByUserId String?
  registeredAt       DateTime?
  createdAt          DateTime  @default(now())

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  registeredBy User?      @relation(fields: [registeredByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderItemId])
  @@index([status])
}

// Single global row driving sequential serial numbers (KE-{year}-{seq}), so
// concurrent stock additions never collide. Incremented atomically inside the
// same transaction that creates the new ProductUnit rows.
model SerialCounter {
  id    String @id @default("global")
  value Int    @default(0)
}

// Audit trail for manual stock changes — every adjustment records why, so
// inventory value changes are traceable without ever touching an Order,
// meaning they never affect revenue, sales, or profit reporting.
model StockAdjustment {
  id            String   @id @default(cuid())
  productId     String
  type          String   // SET | ADD | SUBTRACT
  delta         Int      // signed change actually applied
  previousStock Int
  newStock      Int
  reason        String?  @db.Text
  adminEmail    String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  productId String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model EnergyData {
  id          String   @id @default(cuid())
  userId      String
  consumption Float    @default(0)
  production  Float    @default(0)
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Lead {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  name      String
  phone     String?
  message   String   @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  energyCheckups EnergyCheckup[]
}

enum CheckupMode {
  HOME
  BUSINESS
}

// An Energy Usage Checkup session — a customer-dashboard tool, not a
// marketing-site form. Deliberately named "Checkup", never "audit": that
// word implies a credentialed assessment Kingston Energies does not hold.
// Every submitted session is stored (with consent, at the report gate) so
// v2's expanded appliance library and trend charts have real data to build
// from instead of guesses — see the build spec's data-model guidance.
model EnergyCheckup {
  id     String      @id @default(cuid())
  userId String?
  mode   CheckupMode

  // Household context
  parish       String?
  occupants    Int?
  homeType     String?
  acType       String?
  fridgeAge    String?
  waterHeating String?
  lightType    String?

  // Business context
  bizType String?
  backup  Boolean?

  // Appliance overrides, keyed by appliance id — { [id]: { count, hours } }.
  // Sparse and structured (never free text): unset entries fall back to the
  // library default, so extending the library later never breaks a stored
  // session's replay.
  rows Json

  // The one field that turns a generic guess into a real number.
  billKwh Float?
  billJmd Float?
  month   String?

  // Business-only outage-cost inputs.
  revHour Float?
  stops   Json?

  // What was actually computed and shown — stored as a snapshot so a
  // reopened report, or a future trend chart, doesn't depend on recomputing
  // against a wattage table that may have since changed.
  estimatedKwh  Float
  effectiveRate Float
  rateSource    String // "bill" | "reference"

  // Lead capture (the report gate) — the same customer/lead system used
  // everywhere else in the business, never a parallel list.
  leadContact  String?
  leadChannel  String? // "email" | "whatsapp"
  reportSentAt DateTime?
  leadId       String?
  lead         Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Attribution, so Checkup completions can be tied back to the content or
  // channel that drove them.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Order {
  id           String      @id @default(cuid())
  orderNo       String      @unique
  userId        String?
  customerName  String
  status        OrderStatus @default(PENDING)
  source        OrderChannel @default(WEBSITE)
  contact       String?     // WhatsApp number / Instagram handle for off-site orders
  email         String?     // captured at checkout — used for guest invoices/receipts
  phone         String?
  shippingAddress String?   @db.Text
  billingAddress  String?   @db.Text
  paymentMethod String?
  paid          Boolean     @default(false) // payment received/confirmed
  // The discount code redeemed on this order, if any — kept even though the
  // discount itself was already folded into `total`/line items, because
  // without it there's no way to know which code (or which campaign, via
  // Campaign.discountCodeId) actually drove a sale. See lib/campaignAttribution.ts.
  promoCode     String?
  // Last-click campaign attribution: set when a customer's most recent
  // campaign-link click (within the attribution window — see
  // lib/campaignClick.ts) precedes this order. Covers campaigns that don't
  // have a linked discount code, which promoCode-based attribution can't see.
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  invoicedAt    DateTime?   // when an invoice was issued/sent (prevents dupes)
  cancelReason  String?
  cancelledAt   DateTime?
  stage         Int         @default(0) // 0-7 position in the 8-stage delivery pipeline
  estimatedDelivery DateTime? // admin-set / auto ETA shown to the customer
  // Set when an admin defers the order (stock-out, supplier delay, etc.) —
  // independent of `status`/`stage` so a delayed order still shows where it
  // actually is in the pipeline, just with a visible reason attached.
  delayed       Boolean     @default(false)
  delayReason   String?     @db.Text
  delayedAt     DateTime?
  total         Float       @default(0)
  proofOfPaymentPath String? // private storage path — customer-uploaded receipt/screenshot
  proofOfPaymentAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]

  @@index([userId])
  // Hot filters as the orders table grows: admin views/status changes filter
  // on status, most lists sort by createdAt, and isFirstTimeCustomer() /
  // guest lookups filter by email — all sequential-scan today at low volume,
  // index scans once this table is large.
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([promoCode])
  @@index([campaignId])
}

// Timeline events for an order (cancellations, stage changes, notes). Powers
// the cancellation log and the delivery pipeline.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String   // STATUS | CANCELLED | NOTE
  label     String?
  note      String?  @db.Text
  adminOnly Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Where an order originated — lets the dashboard tag WhatsApp/Instagram orders
// distinctly from website checkouts.
enum OrderChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACE_TO_FACE
  PHONE
  OTHER
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  qty       Int     @default(1)
  price     Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  units   ProductUnit[]
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  files          ProcurementFile[]
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  supplierId String
  reference  String
  status     POStatus @default(OPEN)
  amount     Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  files    ProcurementFile[]

  @@index([supplierId])
}

// A procurement attachment — an uploaded file OR an external link — hung off a
// supplier and/or a purchase order. Covers invoices, quotes, price lists,
// contracts and reference links ("anything relevant to procurement").
model ProcurementFile {
  id              String            @id @default(cuid())
  label           String
  kind            ProcurementKind   @default(OTHER)
  url             String?           // external link — null when it's an uploaded file
  storagePath     String?           // Supabase Storage key — null when it's a link
  fileName        String?           // original filename, for display/download
  supplierId      String?
  purchaseOrderId String?
  createdAt       DateTime          @default(now())

  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([purchaseOrderId])
}

enum ProcurementKind {
  INVOICE
  QUOTE
  PRICE_LIST
  CONTRACT
  LINK
  OTHER
}

model SupportTicket {
  id           String       @id @default(cuid())
  userId       String?
  customerName String
  subject      String
  status       TicketStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String   // catalog product id (e.g. "pb10") — the shop reads lib/catalog.ts, not Product
  userId    String?
  author    String
  location  String?
  rating    Int      @default(5)
  body      String   @db.Text
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // One review per customer per product (seeded reviews have userId = null and
  // are unaffected — the constraint only binds rows that have a userId).
  @@unique([userId, productId])
  @@index([productId])
}

// Folds a duplicate guest-checkout email into the canonical customer record
// it was merged into, so the admin Customers list stops double-counting them
// (aliasEmail resolves to canonicalEmail everywhere customers are aggregated).
model CustomerAlias {
  id             String   @id @default(cuid())
  aliasEmail     String   @unique
  canonicalEmail String
  createdAt      DateTime @default(now())

  @@index([canonicalEmail])
}

model RestockRequest {
  id        String   @id @default(cuid())
  productId String   // catalog product id (e.g. "pb10")
  email     String
  createdAt DateTime @default(now())

  // One signup per email per product — resubmitting just no-ops.
  @@unique([productId, email])
  @@index([productId])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum CustomerSegment {
  VIP
  REPEAT
  NEW
}

// IDIC "Identify" — the primary use-case a customer's portable-power purchase
// serves. Kept in sync with CUSTOMER_NEEDS in lib/crm.ts.
enum CustomerNeed {
  EVERYDAY
  BACKUP
  OFFGRID
  BUSINESS
}

// IDIC "Interact" — a Net Promoter Score response collected after an order or
// a Jordyn support interaction. Score is 0–10; see lib/crm.ts for bucketing.
model NpsResponse {
  id        String    @id @default(cuid())
  userId    String?
  score     Int
  comment   String?   @db.Text
  source    NpsSource @default(ORDER)
  orderNo   String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source])
}

enum NpsSource {
  ORDER
  SUPPORT
}

// Admin policy / documentation links — e.g. Google Drive share URLs for SOPs,
// warranty policy, staff guides. Stored as links so no Drive API is required.
model PolicyDoc {
  id          String   @id @default(cuid())
  title       String
  url         String?  // external link (Drive etc.) — null when it's an uploaded file
  storagePath String?  // Supabase Storage key — null when it's an external link
  fileName    String?  // original filename, for display/download
  category    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum ProductCategory {
  POWERBANKS
  CHARGERS
  STATIONS
  ACCESSORIES
  COMPONENTS
}

// Generic key/value store for admin-editable site settings (e.g. the payment
// methods config JSON under key "payments"). Avoids a migration per setting.
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Double-entry general ledger.
//
// This is the financial system of record. Orders, payments, expenses and stock
// adjustments all POST here as balanced journal entries; every statement
// (Trial Balance, Balance Sheet, P&L, Cash Flow) is then DERIVED from these
// lines rather than re-summed ad hoc from operational tables. That's what makes
// a real Balance Sheet and an auditable trail possible.
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model LedgerAccount {
  id        String      @id @default(cuid())
  code      String      @unique // e.g. "1100"
  name      String
  type      AccountType
  subtype   String? // e.g. "Current asset", "Cost of sales"
  parentId  String?
  // Cash/bank accounts are the ones that can be reconciled against a statement.
  isBank    Boolean     @default(false)
  // System accounts are referenced by the posting engine by code and must not
  // be deleted or renumbered.
  isSystem  Boolean     @default(false)
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   LedgerAccount? @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("AccountTree")
  lines           JournalLine[]
  reconciliations Reconciliation[]
  bankConnections BankConnection[]
  bankRules       BankRule[]

  @@index([type])
  @@index([parentId])
}

enum JournalSource {
  ORDER // revenue recognised when an order is placed
  PAYMENT // cash received against a receivable
  EXPENSE // logged operating expense
  COGS // cost of goods sold + inventory relief
  STOCK_ADJUSTMENT // manual inventory correction
  PAYROLL // approved payroll run — wages, withholdings, employer contributions
  MANUAL // hand-written journal entry
  OPENING // opening balances
}

model JournalEntry {
  id        String        @id @default(cuid())
  entryNo   String        @unique // JE-000123
  date      DateTime
  memo      String?       @db.Text
  source    JournalSource @default(MANUAL)
  // Operational row this entry was posted from (Order.id, Expense.id, …).
  // Combined with `source` it makes posting idempotent — we never double-post.
  sourceId  String?
  createdBy String? // admin email
  reversedById String? @unique // the entry that reverses this one, if any
  createdAt DateTime      @default(now())

  // Which part of the business this belongs to. Null means unassigned rather
  // than a separate ledger — reports filter on it, they don't split on it.
  branchId String?

  // The currency the transaction actually happened in, and the rate used to
  // express it in JMD. Line amounts are always JMD (the functional currency),
  // so every statement stays addable; these two record what was converted and
  // at what rate, which is the part an auditor asks about.
  currency       String @default("JMD")
  fxRate         Float  @default(1)
  originalAmount Float?

  lines      JournalLine[]
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry? @relation("Reversal", fields: [reversedById], references: [id], onDelete: SetNull)
  reverses   JournalEntry? @relation("Reversal")

  @@unique([source, sourceId])
  @@index([date])
  @@index([source])
  @@index([branchId])
}

model JournalLine {
  id        String @id @default(cuid())
  entryId   String
  accountId String
  // Stored as separate debit/credit columns (never a single signed amount) so
  // the ledger reads the way an accountant expects and imbalances are obvious.
  debit     Float  @default(0)
  credit    Float  @default(0)
  memo      String?
  // Set once this line has been ticked off against a bank statement.
  reconciliationId String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  bankLines      BankStatementLine[]

  @@index([entryId])
  @@index([accountId])
  @@index([reconciliationId])
}

// ---------------------------------------------------------------------------
// Bank reconciliation
//
// Ticking a journal line off against a statement never edits the line's amount
// — it only records that the bank agrees. That keeps reconciliation an
// assertion about reality rather than a way to quietly fudge the books.
// ---------------------------------------------------------------------------

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

model Reconciliation {
  id               String               @id @default(cuid())
  accountId        String
  statementDate    DateTime
  beginningBalance Float                @default(0)
  endingBalance    Float
  status           ReconciliationStatus @default(IN_PROGRESS)
  completedAt      DateTime?
  completedBy      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Straight-line schedules: fixed assets, prepaid expenses, deferred revenue.
//
// All three are the same shape — move a fixed amount per period from one
// account to another until the balance is consumed — so they share one
// ScheduleRun table recording each posted period.
// ---------------------------------------------------------------------------

enum ScheduleKind {
  DEPRECIATION
  AMORTIZATION
  REVENUE_RECOGNITION
}

model ScheduleRun {
  id        String       @id @default(cuid())
  kind      ScheduleKind
  // FixedAsset.id | PrepaidExpense.id | RevenueSchedule.id
  refId     String
  // First day of the period this run covers, e.g. 2026-07-01.
  periodDate DateTime
  amount    Float
  entryId   String?
  createdAt DateTime     @default(now())

  // One run per schedule per period — makes posting idempotent, so a monthly
  // run can be triggered twice without double-charging depreciation.
  @@unique([kind, refId, periodDate])
  @@index([refId])
}

model FixedAsset {
  id              String    @id @default(cuid())
  name            String
  description     String?   @db.Text
  cost            Float
  salvageValue    Float     @default(0)
  usefulLifeMonths Int
  acquiredAt      DateTime
  // Ledger accounts this asset posts against (codes, resolved at post time).
  assetAccountCode        String @default("1500")
  accumDepAccountCode     String @default("1590")
  depreciationExpenseCode String @default("6800")
  disposedAt      DateTime?
  disposalProceeds Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([acquiredAt])
}

model PrepaidExpense {
  id            String   @id @default(cuid())
  description   String
  totalAmount   Float
  startDate     DateTime
  months        Int
  prepaidAccountCode String @default("1300")
  expenseAccountCode String @default("6900")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
}

model RevenueSchedule {
  id            String   @id @default(cuid())
  description   String
  customerName  String?
  orderId       String?
  totalAmount   Float
  startDate     DateTime
  months        Int
  deferredAccountCode String @default("2400")
  revenueAccountCode  String @default("4000")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
}

// A logged business expense — the manual side of the Finance section (revenue
// comes automatically from orders).
model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Float
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  // The receipt this expense was raised from, if any.
  document DocumentScan?
  // The campaign this expense was posted for, if it came from campaign spend.
  campaign Campaign?
  // Every correction made after this expense was first logged — append-only,
  // never overwritten, so a figure can be fixed without the original ever
  // being silently lost.
  edits ExpenseEdit[]

  @@index([spentAt])
}

// One correction to an already-logged expense. Written alongside — never
// instead of — reversing and reposting the expense's ledger entry, so the
// journal and this log always agree on what changed and why.
model ExpenseEdit {
  id          String   @id @default(cuid())
  expenseId   String

  beforeCategory    String
  beforeDescription String?
  beforeAmount      Float
  beforeSpentAt     DateTime

  afterCategory    String
  afterDescription String?
  afterAmount      Float
  afterSpentAt     DateTime

  reason    String  @db.Text
  editedBy  String?
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

// A recurring monthly budget target per expense category.
model Budget {
  id            String   @id @default(cuid())
  category      String   @unique
  monthlyAmount Float
  updatedAt     DateTime @updatedAt
}

// An admin-managed promo/discount code applied at checkout.
model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType @default(PERCENT)
  value       Float        // percent (0–100) for PERCENT, J$ off for FIXED
  minSpend    Float?       // minimum cart subtotal to qualify
  active      Boolean      @default(true)
  expiresAt   DateTime?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  campaigns   Campaign[]
}

enum DiscountType {
  PERCENT
  FIXED
}

// A marketing campaign the admin can categorise, schedule and action (email
// blasts send for real via Resend; other channels are tracked/handled via your
// external tooling e.g. n8n/WhatsApp).
model Campaign {
  id             String          @id @default(cuid())
  name           String
  channel        CampaignChannel @default(EMAIL)
  category       String?
  subject        String?
  body           String?         @db.Text
  status         CampaignStatus  @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Optional audience: a saved Segment instead of "every subscriber".
  segmentId      String?
  segment        Segment?        @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  // Optional linked discount code — the mechanism campaign-to-revenue
  // attribution uses: orders that redeemed this code count as this
  // campaign's results. A campaign without one has no attributed revenue,
  // shown honestly as "not tracked" rather than a fabricated number.
  discountCodeId String?
  discountCode   DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  // Optional manual spend entry (e.g. a paid boost) so ROI can be shown
  // alongside attributed revenue when the admin knows the cost. Editable
  // freely while the campaign hasn't sent yet; once it sends with spend > 0
  // it's posted as a real Expense (see lib/campaigns.ts) and locked, so the
  // number in Marketing always matches what Finance actually recorded.
  spend          Float?
  expenseId      String?         @unique
  expense        Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  orders         Order[]

  @@index([createdAt])
  @@index([segmentId])
  @@index([discountCodeId])
}

enum CampaignChannel {
  EMAIL
  SMS
  PUSH
  SOCIAL
}

// A reusable subject/body starting point so a recurring campaign (a monthly
// newsletter, a restock announcement) doesn't get retyped from scratch —
// saved once from the composer, picked from a list next time.
model CampaignTemplate {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel @default(EMAIL)
  category  String?
  subject   String?
  body      String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

// A saved, reusable customer filter usable as a campaign audience. Criteria
// are stored as JSON (see lib/segments.ts for the shape) and evaluated live
// against Customer/Order data at read time — no membership snapshot to keep
// in sync, so a segment is always current.
model Segment {
  id          String     @id @default(cuid())
  name        String
  description String?
  criteria    Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  campaigns   Campaign[]
}

// Emails that must never receive a marketing send again — unsubscribed via
// the one-click link in every campaign, or added manually by an admin.
// Independent of User (covers guest-checkout emails too, which have no
// account) and independent of transactional email (order confirmations,
// password resets, etc. are never gated by this).
model Suppression {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

enum SuppressionReason {
  UNSUBSCRIBED
  BOUNCED
  MANUAL
}

// Records that a lifecycle automation (welcome series, review request, ...)
// has already fired for a given trigger, so the cron that runs them can't
// send the same one twice. `key` encodes both which automation and which
// trigger instance, e.g. "welcome:<userId>" or "review-request:<orderId>".
model AutomationSend {
  id     String   @id @default(cuid())
  key    String   @unique
  email  String
  sentAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PACKED
  OUT
  DONE
  CANCELLED
}

enum POStatus {
  OPEN
  RECEIVED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// ---------------------------------------------------------------------------
// Payroll
//
// Infrastructure only: this calculates pay, produces payslips and posts the
// resulting journal entries. It deliberately does NOT move money — payments are
// made directly by the business, and marking a run as paid is an assertion that
// that happened, not an instruction to a payment rail.
// ---------------------------------------------------------------------------

enum PayFrequency {
  MONTHLY
  FORTNIGHTLY
  WEEKLY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id            String         @id @default(cuid())
  employeeNo    String         @unique
  firstName     String
  lastName      String
  email         String?
  phone         String?
  // Jamaican statutory identifiers.
  trn           String? // Taxpayer Registration Number
  nisNumber     String?
  jobTitle      String?
  department    String?
  // Gross pay for one period at the stated frequency.
  grossPerPeriod Float
  frequency     PayFrequency   @default(MONTHLY)
  status        EmployeeStatus @default(ACTIVE)
  startedAt     DateTime
  endedAt       DateTime?
  bankAccount   String? // reference only — nothing is paid from here
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payslips Payslip[]

  @@index([status])
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id          String           @id @default(cuid())
  runNo       String           @unique
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  status      PayrollRunStatus @default(DRAFT)
  // Rates in force when this run was calculated, frozen as JSON so a historic
  // payslip always reproduces exactly, even after rates are changed.
  rateSnapshot Json
  approvedAt  DateTime?
  approvedBy  String?
  paidAt      DateTime?
  entryId     String? // journal entry posted on approval
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payslips Payslip[]

  @@index([periodStart])
}

model Payslip {
  id         String @id @default(cuid())
  runId      String
  employeeId String

  gross      Float
  // Employee-side deductions.
  paye       Float @default(0)
  nisEmployee Float @default(0)
  nhtEmployee Float @default(0)
  edTaxEmployee Float @default(0)
  otherDeductions Float @default(0)
  net        Float

  // Employer-side contributions — a cost to the business, not deducted from pay.
  nisEmployer   Float @default(0)
  nhtEmployer   Float @default(0)
  edTaxEmployer Float @default(0)
  heartEmployer Float @default(0)

  createdAt DateTime @default(now())

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Bank feeds.
//
// A bank connection is a source of statement lines for one ledger account.
// Statement lines are the bank's version of events; journal lines are ours.
// Matching the two is what reconciliation actually is, so lines are imported
// as raw fact and never post to the ledger on their own — a human decides what
// each one means before anything hits the books.
//
// No live bank API is contracted, so FILE_IMPORT and MANUAL are the paths that
// work today. API exists as a declared provider so an aggregator can be dropped
// in later without reshaping the data.
// ---------------------------------------------------------------------------

enum BankFeedProvider {
  MANUAL // typed in by hand
  FILE_IMPORT // CSV or OFX/QFX exported from online banking
  API // live feed from a bank or aggregator — none configured
}

enum BankConnectionStatus {
  ACTIVE
  DISABLED
}

model BankConnection {
  id           String               @id @default(cuid())
  accountId    String
  name         String // "NCB Business Chequing"
  institution  String?
  // Last four digits only — never store a full account number.
  maskedNumber String?
  provider     BankFeedProvider     @default(FILE_IMPORT)
  status       BankConnectionStatus @default(ACTIVE)
  currency     String               @default("JMD")
  lastImportAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  account LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines   BankStatementLine[]

  @@index([accountId])
}

enum BankLineStatus {
  UNMATCHED // the bank says this happened; our books do not show it yet
  MATCHED // tied to an existing journal line
  POSTED // a new journal entry was created from it
  EXCLUDED // deliberately ignored (duplicate, transfer already booked, etc.)
}

model BankStatementLine {
  id           String @id @default(cuid())
  connectionId String

  postedAt    DateTime
  description String   @db.Text
  reference   String?
  // Signed against the bank account: positive is money in, negative is money out.
  amount      Float
  runningBalance Float?

  // Hash of the source row. Re-importing an overlapping statement is a no-op
  // rather than a duplicate, which is the single thing that ruins a bank feed.
  fingerprint String

  status        BankLineStatus @default(UNMATCHED)
  journalLineId String? // matched to an existing book entry
  entryId       String? // or a new entry was posted from it
  note          String?
  resolvedAt    DateTime?
  resolvedBy    String?
  importedAt    DateTime       @default(now())

  connection  BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  journalLine JournalLine?   @relation(fields: [journalLineId], references: [id], onDelete: SetNull)

  @@unique([connectionId, fingerprint])
  @@index([connectionId, status])
  @@index([postedAt])
}

// ---------------------------------------------------------------------------
// Document capture.
//
// A receipt is evidence. Storing it against the expense is the part that
// matters for audit, and that works today with no OCR at all.
//
// Extraction is an optional convenience layered on top: if an OCR provider is
// configured it pre-fills the fields, and if one isn't, they're typed in. Either
// way a human confirms before an expense is raised, because an amount read
// wrongly off a crumpled receipt is indistinguishable from a correct one once
// it's in the books.
// ---------------------------------------------------------------------------

enum DocumentKind {
  RECEIPT
  BILL
  STATEMENT
  OTHER
}

enum ScanStatus {
  NEEDS_REVIEW // stored, fields not yet confirmed by a person
  CONFIRMED // a person has confirmed the fields
  FAILED // the file could not be stored or read
}

model DocumentScan {
  id          String       @id @default(cuid())
  kind        DocumentKind @default(RECEIPT)
  // Path in the PRIVATE admin bucket. Access is always via a short-lived
  // signed URL minted inside an admin-guarded route.
  storagePath String
  filename    String
  contentType String
  sizeBytes   Int

  status ScanStatus @default(NEEDS_REVIEW)
  // Which extractor produced the draft fields, or null when they were typed in.
  provider String?
  // Whatever the provider returned, kept verbatim so a bad extraction can be
  // investigated rather than guessed at.
  raw      Json?
  // Per-field confidence from the provider, so weak reads can be flagged
  // instead of presented with the same certainty as strong ones.
  confidence Json?

  // Draft or confirmed fields.
  vendor       String?
  documentDate DateTime?
  total        Float?
  taxAmount    Float?
  currency     String    @default("JMD")
  category     String?
  notes        String?   @db.Text

  expenseId   String?   @unique
  uploadedBy  String?
  confirmedAt DateTime?
  confirmedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Branches and currency.
//
// A branch is a reporting dimension on the one ledger, not a second set of
// books. Splitting the ledger per location is what makes group figures stop
// adding up, so entries carry a branch and reports filter on it.
//
// JMD is the functional currency: every journal line is in JMD, always. A
// foreign-currency transaction records what it was in and the rate applied, and
// the rate must be one someone entered — nothing here invents a rate or quietly
// reuses a stale one.
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // "KGN", "MOBAY"
  name      String
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries JournalEntry[]
}

model ExchangeRate {
  id       String   @id @default(cuid())
  // ISO code of the foreign currency; the quote is always against JMD.
  currency String
  // How many JMD one unit of `currency` buys.
  rate     Float
  asOf     DateTime
  // Where the rate came from — "BOJ", "bank advice", a person's name. Recorded
  // because "which rate did you use" is the first question anyone asks.
  source   String?
  enteredBy String?
  createdAt DateTime @default(now())

  @@unique([currency, asOf])
  @@index([currency, asOf])
}

// ---------------------------------------------------------------------------
// Business feed state.
//
// The feed itself is derived from real records, so there is nothing to store
// about what happened. What IS worth storing is what a person decided about it:
// pinned, snoozed, assigned, resolved. That is keyed by the item's stable id
// (e.g. "unpaid:<orderId>"), so the decision survives the feed being rebuilt.
// ---------------------------------------------------------------------------

model FeedState {
  id           String    @id @default(cuid())
  itemId       String    @unique
  pinned       Boolean   @default(false)
  archived     Boolean   @default(false)
  // Hidden until this time, then it comes back — snoozing is deferral, not
  // dismissal, which is the difference between a feed and an inbox you ignore.
  snoozedUntil DateTime?
  resolvedAt   DateTime?
  resolvedBy   String?
  assignedTo   String?
  note         String?   @db.Text
  updatedAt    DateTime  @updatedAt

  @@index([archived, pinned])
}

// ---------------------------------------------------------------------------
// Bank rules.
//
// A rule says "a statement line whose description contains X is category Y".
// It saves the same decision being made forty times a month.
//
// By default a rule SUGGESTS rather than posts. Auto-posting is opt-in per
// rule, because a rule that quietly books a transaction to the wrong account is
// a lot harder to notice than one that offers a suggestion you can decline.
// ---------------------------------------------------------------------------

model BankRule {
  id        String  @id @default(cuid())
  name      String
  // Matched case-insensitively against the statement line description.
  contains  String
  // IN (money in), OUT (money out), or ANY. Stops a rule for "TRANSFER"
  // catching both directions of the same word.
  direction String  @default("ANY")
  accountId String
  // Lower numbers win. Two rules can match one line; the order must be a
  // decision, not whichever the database happened to return first.
  priority  Int     @default(100)
  enabled   Boolean @default(true)
  autoPost  Boolean @default(false)

  // How often this rule has actually fired, so a rule that never matches is
  // visible as dead weight rather than assumed to be working.
  matchCount Int      @default(0)
  lastMatchAt DateTime?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([enabled, priority])
}
